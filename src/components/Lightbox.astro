---
// One shared <dialog> that enlarges any `a[data-lightbox]` link on the page.
//
// Mark up a trigger as <a href="/full-size.jpg" data-lightbox="group" data-caption="...">.
// Links with the same `data-lightbox` group value are stepped through with the
// arrow buttons / arrow keys. Without JS the link just opens the full image.
---

<dialog class="lightbox" aria-label="Enlarged image">
  <button class="lb-close" type="button" aria-label="Close">×</button>
  <button class="lb-nav lb-prev" type="button" aria-label="Previous image">‹</button>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button class="lb-nav lb-next" type="button" aria-label="Next image">›</button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  if (dialog) {
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.lb-prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.lb-next')!;

    let group: HTMLAnchorElement[] = [];
    let index = 0;

    const show = (i: number) => {
      index = (i + group.length) % group.length;
      const link = group[index];
      const thumb = link.querySelector('img');
      img.removeAttribute('src');
      img.alt = link.dataset.alt ?? thumb?.alt ?? '';
      img.src = link.href;
      caption.textContent = link.dataset.caption ?? '';
      caption.hidden = !caption.textContent;
      const single = group.length < 2;
      prev.hidden = next.hidden = single;
    };

    document.addEventListener('click', (event) => {
      // Let modified clicks (new tab, etc.) behave normally.
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-lightbox]');
      if (!link) return;
      event.preventDefault();
      const name = link.dataset.lightbox;
      group = [...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')].filter(
        (a) => a.dataset.lightbox === name,
      );
      dialog.showModal();
      show(group.indexOf(link));
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());

    // Clicking the dark backdrop (not the image or buttons) closes.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || (event.target as Element).tagName === 'FIGURE') dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' && group.length > 1) show(index - 1);
      if (event.key === 'ArrowRight' && group.length > 1) show(index + 1);
    });

    dialog.addEventListener('close', () => img.removeAttribute('src'));
  }
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: rgb(10 10 10 / 0.92);
    color: #f2f2f2;
    place-items: center;
  }
  .lightbox[open] {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.5rem;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox figure {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin: 0;
    min-width: 0;
    max-height: 100%;
  }
  .lightbox img {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 6rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius);
  }
  .lightbox figcaption {
    font-weight: 700;
    text-align: center;
  }
  .lightbox button {
    appearance: none;
    border: 0;
    background: rgb(255 255 255 / 0.12);
    color: inherit;
    font: inherit;
    line-height: 1;
    cursor: pointer;
    border-radius: 999px;
  }
  .lightbox button:hover,
  .lightbox button:focus-visible {
    background: rgb(255 255 255 / 0.25);
  }
  .lb-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.75rem;
  }
  .lb-nav {
    width: 2.75rem;
    height: 2.75rem;
    font-size: 2rem;
  }
  .lb-nav[hidden] {
    display: none;
  }
  /* Phones: tuck the arrows under the image instead of squeezing it. */
  @media (max-width: 40rem) {
    .lightbox[open] {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      align-content: center;
    }
    .lightbox figure {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .lb-prev {
      grid-row: 2;
      justify-self: end;
      margin-right: 1rem;
    }
    .lb-next {
      grid-row: 2;
      justify-self: start;
      margin-left: 1rem;
    }
  }
</style>
