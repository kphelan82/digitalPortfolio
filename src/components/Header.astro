---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import logo from '../assets/logo/KPD-logo.svg';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// "Work" (/) is also the parent of every /work/* case study page.
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/work') : path === href;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <Image src={logo} alt="" width={28} height={31} />
      <span>{site.name}</span>
    </a>
    <div class="controls">
      <nav aria-label="Main">
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  /* Sticky on tablet and mobile only — on desktop the header just scrolls
     away normally. Needs its own opaque background since it now sits over
     content while scrolling, and a bottom border to separate the two once
     something is actually scrolling underneath it. */
  @media (max-width: 1024px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
    }
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    text-decoration: none;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    text-decoration: none;
    color: var(--color-muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.35em;
  }
</style>
