---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import logo from '../assets/logo/KPD-logo.svg';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// "Work" (/) is also the parent of every /work/* case study page.
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/work') : path === href;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <Image class="brand-logo" src={logo} alt="" width={44} height={49} />
      <span class="brand-text">
        <span class="brand-name">{site.name}</span>
        <span class="brand-tagline">{site.brandTagline}</span>
      </span>
    </a>
    <div class="controls">
      <nav aria-label="Main">
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  /* Sticky at every breakpoint. Needs its own opaque background since it
     now sits over content while scrolling, and a bottom border to separate
     the two once something is actually scrolling underneath it.

     The header is intentionally locked to the dark palette regardless of
     the site's light/dark toggle — it uses the fixed --header-* tokens
     from global.css, not the theme-reactive --color-* ones, so it stays
     put while the toggle switches the rest of the page. Setting `color`
     here means the brand link (which relies on the global `a { color:
     inherit }` rule) picks up the right text color automatically. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--header-bg);
    color: var(--header-text);
    border-bottom: 1px solid var(--header-border);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2);
  }
  /* The logo lockup: icon + name, with a tagline that only appears once
     there's enough room for it (see the media query below). The name is
     styled as part of the mark (bold, brand red, lowercase) rather than
     like a regular nav link — deliberately, so it doesn't read as "just
     another item" in the nav row even though the whole lockup still links
     home, which is standard and expected. */
  .brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-heading);
    text-decoration: none;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  /* Sized and tracked out so "kevin phelan" spans the same rendered width
     as the tagline below it once the tagline is showing — tuned by
     measuring both lines' actual glyph widths in the browser, not
     guessed. Applied at every breakpoint (not just where the tagline
     shows) so the wordmark reads as one consistent logo regardless of
     whether the tagline is present. This match only holds for this exact
     name/tagline pair at these exact sizes; if either text or the name's
     font-size ever changes, re-measure and adjust letter-spacing rather
     than assume it still lines up. */
  .brand-name {
    font-size: 1.75rem;
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: 0.106em;
    color: var(--header-brand-red);
  }
  .brand-tagline {
    display: none;
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: lowercase;
    letter-spacing: 0.01em;
    color: var(--header-accent);
  }
  @media (min-width: 52rem) {
    .brand-tagline {
      display: block;
    }
    /* The logo's own artwork has a straight vertical edge on its right
       side (the "d" stroke, from y=70.41 to y=272.79 in its 372-tall
       viewBox — 54.4% of the icon's total height). Sized here so that
       edge matches the height of the two-line text block next to it,
       measured at 47.125px: 47.125 / 0.5440 = 86.62px icon height. Width
       is left to `auto` so it scales off the logo's own aspect ratio
       rather than a second hand-computed number. Re-derive this if the
       logo artwork, its two-line text block's size, or its line-height
       ever changes. */
    .brand-logo {
      height: 86.62px;
      width: auto;
    }
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    text-decoration: none;
    color: var(--header-muted);
    font-weight: 700;
    text-transform: lowercase;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--header-text);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--header-accent);
    text-underline-offset: 0.35em;
  }
  /* The global :focus-visible rule uses the page's (theme-reactive) accent
     color, which would be low-contrast against this always-dark header
     once the page itself switches to light. Pin it to the header's own. */
  .brand:focus-visible,
  nav a:focus-visible {
    outline-color: var(--header-accent);
  }
</style>
