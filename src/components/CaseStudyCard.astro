---
import { Image } from 'astro:assets';
import type { CaseStudy } from '../lib/caseStudies';

interface Props {
  entry: CaseStudy;
}

const { entry } = Astro.props;
const { title, client, year, summary, thumbnail, draft } = entry.data;
---

<a class="card" href={`/work/${entry.id}`}>
  <div class="thumb">
    <Image src={thumbnail} alt="" width={800} loading="lazy" />
  </div>
  <h2>{title}</h2>
  <p class="meta muted">
    {client} · {year}
    {draft && <span class="badge">Draft</span>}
  </p>
  <p class="summary">{summary}</p>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
  }
  .card:hover {
    color: inherit;
  }
  .thumb {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
    aspect-ratio: 3 / 2;
    margin-bottom: var(--space-2);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .card:hover .thumb :global(img) {
    transform: scale(1.03);
  }
  .card:hover h2 {
    color: var(--color-accent);
  }
  .meta {
    font-size: var(--text-sm);
    margin-top: 0.25rem;
  }
  .summary {
    margin-top: var(--space-1);
  }
  .badge {
    margin-left: 0.5em;
    padding: 0.1em 0.5em;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb :global(img) {
      transition: none;
    }
    .card:hover .thumb :global(img) {
      transform: none;
    }
  }
</style>
