---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseStudies } from '../../lib/caseStudies';

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: studies[i - 1], next: studies[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, client, year, role, summary, thumbnail } = entry.data;
---

<BaseLayout title={title} description={summary}>
  <article>
    <header class="head">
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <dl class="meta">
        <div><dt>Client</dt><dd>{client}</dd></div>
        <div><dt>Year</dt><dd>{year}</dd></div>
        <div><dt>Role</dt><dd>{role}</dd></div>
      </dl>
    </header>

    <div class="hero">
      <Image src={thumbnail} alt="" width={1600} loading="eager" />
    </div>

    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="More case studies">
    {prev ? <a href={`/work/${prev.id}`}>← {prev.data.title}</a> : <span />}
    {next ? <a href={`/work/${next.id}`}>{next.data.title} →</a> : <span />}
  </nav>
</BaseLayout>

<style>
  .head {
    max-width: var(--content-width);
    margin-bottom: var(--space-3);
  }
  .summary {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-2) 0 0;
  }
  .meta dt {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .meta dd {
    margin: 0;
  }
  .hero {
    margin-bottom: var(--space-3);
  }
  .hero :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }
  .pager a {
    text-decoration: none;
  }
</style>
