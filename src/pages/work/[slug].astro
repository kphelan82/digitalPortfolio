---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseStudies } from '../../lib/caseStudies';
import hexagon from '../../assets/icons/stats/hexagon.svg';
import hexagonBadge from '../../assets/icons/hexagon-badge.svg';

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, index: i, prev: studies[i - 1], next: studies[i + 1] },
  }));
}

const { entry, index, prev, next } = Astro.props;
const { title, client, year, role, product, summary, thumbnail, sections } = entry.data;

// Case studies without `sections` still render their Markdown body (the older
// layout) until they're moved onto the card template.
const Content = sections ? null : (await render(entry)).Content;

// The hexagon badge on the hero is this case study's position in the same order
// the home grid uses, so it stays in step with `order` automatically.
const badgeNumber = String(index + 1).padStart(2, '0');

// The stat hexagon is drawn as a CSS mask so its fill can follow the theme.
const hexMask = `--hex: url('${hexagon.src}')`;

const meta = [
  { label: 'Client', value: client },
  { label: 'Year', value: String(year) },
  { label: 'Role', value: role },
  ...(product ? [{ label: 'Product', value: product }] : []),
];
---

<BaseLayout title={title} description={summary}>
  {
    sections ? (
      <article class="cs">
        <header class="cs-head">
          <h1>{title}</h1>
          <p class="cs-summary">{summary}</p>
        </header>

        <div class="cs-hero">
          <Image class="cs-hero-img" src={thumbnail} alt={`Screenshot of ${title}`} width={1800} loading="eager" />
          <div class="hex-badge" aria-hidden="true">
            <Image src={hexagonBadge} alt="" />
            <span>{badgeNumber}</span>
          </div>
        </div>

        <dl class="cs-meta">
          {meta.map((item) => (
            <div>
              <dt>{item.label}:</dt> <dd>{item.value}</dd>
            </div>
          ))}
        </dl>

        <div class="cs-cards">
          {sections.map((section) => (
            <section class="cs-card">
              <h2>{section.title}</h2>
              {section.paragraphs.map((text) => (
                <p>{text}</p>
              ))}

              {section.list && (
                <ul class="cs-list">
                  {section.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}

              {section.stats && (
                <ul class="stats">
                  {section.stats.map((stat) => (
                    <li>
                      <div class="stat-icon" style={hexMask}>
                        <Image src={stat.icon} alt="" />
                      </div>
                      <span class="stat-value">{stat.value}</span>
                      <span class="stat-label">{stat.label}</span>
                    </li>
                  ))}
                </ul>
              )}

              {section.features && (
                <ul class="features">
                  {section.features.map((feature) => (
                    <li>
                      <figure>
                        <Image src={feature.image} alt={feature.alt} width={300} height={300} loading="lazy" />
                        <figcaption>{feature.caption}</figcaption>
                      </figure>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>
      </article>
    ) : (
      <article>
        <header class="legacy-head">
          <h1>{title}</h1>
          <p class="legacy-summary">{summary}</p>
          <dl class="legacy-meta">
            <div><dt>Client</dt><dd>{client}</dd></div>
            <div><dt>Year</dt><dd>{year}</dd></div>
            <div><dt>Role</dt><dd>{role}</dd></div>
          </dl>
        </header>

        <div class="legacy-hero">
          <Image src={thumbnail} alt="" width={1600} loading="eager" />
        </div>

        <div class="prose">{Content && <Content />}</div>
      </article>
    )
  }

  <nav class="pager" aria-label="More case studies">
    {prev ? <a href={`/work/${prev.id}`}>← {prev.data.title}</a> : <span />}
    {next ? <a href={`/work/${next.id}`}>{next.data.title} →</a> : <span />}
  </nav>
</BaseLayout>

<style>
  /* ==========================================================================
     Card template — see the Figma "Desktop / Tablet / Mobile" case study frames.
     Colors come from the same tokens as the résumé cards (surface, border, text,
     --color-heading-accent for red text) so both pages match.
     ========================================================================== */
  .cs {
    /* Body size in the cards: 20px at desktop, scaling down toward phones. */
    --cs-text: clamp(1rem, 0.9rem + 0.45vw, 1.25rem);
    --cs-pad: clamp(1.5rem, 1.1rem + 1.4vw, 2rem);
  }

  .cs-head {
    margin-bottom: var(--space-3);
  }
  .cs-head h1 {
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.25rem);
    font-weight: 700;
  }
  .cs-summary {
    margin-top: var(--space-1);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
  }

  /* Hero image with the numbered hexagon badge in its corner. */
  .cs-hero {
    position: relative;
  }
  .cs-hero :global(.cs-hero-img) {
    display: block;
    width: 100%;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  /* The badge sits on top of a photo, so it stays dark in both themes (the
     hexagon fill is baked into the SVG). Its numeral uses a fixed lightened
     red — the literal brand red is only ~2.5:1 on that dark fill. */
  .hex-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: grid;
    place-items: center;
    /* Phone: 40px badge, 20px numeral (mobile frame). */
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.25rem;
  }
  /* Tablet and up: 78.27px badge, 32px numeral (desktop and tablet frames). */
  @media (min-width: 40rem) {
    .hex-badge {
      top: 1.25rem;
      left: 1.25rem;
      width: 78.27px;
      height: 78.27px;
      font-size: 2rem;
    }
  }
  .hex-badge :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hex-badge span {
    position: relative;
    font-weight: 800;
    line-height: 1;
    color: var(--badge-hex-text);
  }

  /* Client / Year / Role / Product strip, attached to the hero's bottom edge. */
  .cs-meta {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 var(--space-3);
    padding: 1.125rem 1.125rem 1.5rem;
    background: var(--color-surface);
    border-top: 4px solid var(--color-accent);
    border-radius: 0 0 var(--radius) var(--radius);
    font-size: var(--cs-text);
  }
  .cs-meta dt,
  .cs-meta dd {
    display: inline;
    margin: 0;
  }
  .cs-meta dt {
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-heading-accent);
  }
  /* Tablet: two columns, filled top-to-bottom (Client/Year, then Role/Product). */
  @media (min-width: 40rem) {
    .cs-meta {
      grid-auto-flow: column;
      grid-template-rows: repeat(2, auto);
      grid-auto-columns: minmax(0, 1fr);
      gap: 1.5rem 3rem;
      padding: 1.5rem;
    }
  }
  /* Wide: everything on one line. */
  @media (min-width: 72rem) {
    .cs-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
    }
  }

  .cs-cards {
    display: grid;
    gap: var(--space-3);
  }
  .cs-card {
    padding: var(--cs-pad);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: var(--cs-text);
  }
  .cs-card h2 {
    margin-bottom: 0.5rem;
    font-size: var(--cs-text);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
  }
  .cs-card p + p {
    margin-top: 1em;
  }
  .cs-list {
    margin: 0;
    padding-left: 1.25em;
  }
  .cs-card p + .cs-list {
    margin-top: 1em;
  }
  .cs-list li + li {
    margin-top: 0.25em;
  }

  /* Stats row inside a card: hexagon icon, big red number, label. A centered,
     wrapping row rather than a fixed 4-column grid, so any number of stats
     (1 to 4+) looks balanced: each takes a quarter of the row on wide screens,
     half on tablet, the full width on phones, and leftovers sit in the middle. */
  .stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .stats li {
    display: flex;
    flex: 0 0 100%;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .stat-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 129px;
    height: 129px;
  }
  /* The hexagon: the page background color, so it reads as a cut-out badge on
     the card's surface in both themes. */
  .stat-icon::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    -webkit-mask: var(--hex) center / contain no-repeat;
    mask: var(--hex) center / contain no-repeat;
  }
  .stat-icon :global(img) {
    position: relative;
  }
  .stat-value {
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.625rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-heading-accent);
  }
  .stat-label {
    font-weight: 700;
  }
  @media (min-width: 40rem) {
    .stats li {
      flex-basis: calc((100% - 1.5rem) / 2);
    }
  }
  @media (min-width: 60rem) {
    .stats li {
      flex-basis: calc((100% - 3 * 1.5rem) / 4);
    }
  }

  /* Feature screenshots: 1 column on phones, 2 on tablet, 3 on desktop. */
  .features {
    display: grid;
    gap: var(--space-3) 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    justify-self: center;
    width: 100%;
    max-width: 300px;
  }
  .features figure {
    margin: 0;
    text-align: center;
  }
  .features :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .features figcaption {
    margin-top: 0.5rem;
    font-weight: 700;
  }
  @media (min-width: 40rem) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 300px));
      justify-content: space-between;
    }
    .features li {
      justify-self: stretch;
    }
  }
  @media (min-width: 60rem) {
    .features {
      grid-template-columns: repeat(3, minmax(0, 300px));
    }
  }

  /* ==========================================================================
     Older layout, for case studies that haven't moved onto the template yet.
     ========================================================================== */
  .legacy-head {
    max-width: var(--content-width);
    margin-bottom: var(--space-3);
  }
  .legacy-summary {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }
  .legacy-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-2) 0 0;
  }
  .legacy-meta dt {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .legacy-meta dd {
    margin: 0;
  }
  .legacy-hero {
    margin-bottom: var(--space-3);
  }
  .legacy-hero :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }
  .pager a {
    text-decoration: none;
  }
</style>
