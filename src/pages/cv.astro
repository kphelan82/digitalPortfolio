---
// Résumé lives at /cv because the old /resume URL redirects here (see astro.config.mjs).
// Content comes from src/data/resume.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { resume } from '../data/resume';
---

<BaseLayout title="Résumé" description={`Résumé of ${site.name}: experience, education, skills and certifications.`}>
  <h1 class="page-title">Résumé</h1>

  <div class="prose">
    {
      site.resumePdf && (
        <p>
          <a href={site.resumePdf} download>
            Download PDF
          </a>
        </p>
      )
    }

    <h2>About me</h2>
    <p>{resume.about}</p>

    <h2>Industry experience</h2>
    {
      resume.experience.map((job) => (
        <section class="job">
          <h3>{job.title}</h3>
          <p class="muted">
            {job.company} · {job.location} · {job.dates}
          </p>
          <p>{job.description}</p>
          <p class="label">{job.highlightsLabel}</p>
          <ul>
            {job.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <h2>Key skills</h2>
    <ul>
      {resume.skills.map((skill) => <li>{skill}</li>)}
    </ul>

    <h2>Education</h2>
    {
      resume.education.map((item) => (
        <section>
          <h3>{item.degree}</h3>
          <p class="muted">
            {item.school}, {item.location} · {item.year}
            {item.honors && `, ${item.honors}`}
          </p>
        </section>
      ))
    }

    <h2>Certifications</h2>
    <ul>
      {resume.certifications.map((cert) => <li>{cert}</li>)}
    </ul>

    <h2>Affiliations</h2>
    <ul>
      {resume.affiliations.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</BaseLayout>

<style>
  .job + .job {
    margin-top: var(--space-3);
  }
  .label {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
