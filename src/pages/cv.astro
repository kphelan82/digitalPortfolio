---
// Résumé lives at /cv because the old /resume URL redirects here (see astro.config.mjs).
// Content comes from src/data/resume.ts.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { resume } from '../data/resume';
import educationIcon from '../assets/icons/education_icon.svg';
import certificationsIcon from '../assets/icons/certifications_icon.svg';
import affiliationsIcon from '../assets/icons/affiliations_icon.svg';
---

<BaseLayout title="Résumé" description={`Résumé of ${site.name}: experience, education, and certifications.`}>
  <div class="cv-header">
    <h1 class="page-title">résumé</h1>
    {
      site.resumePdf && (
        <a class="download-btn" href={site.resumePdf} download>
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none">
            <path
              d="M10 3v9m0 0 3.5-3.5M10 12l-3.5-3.5M4 14.5V16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-1.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          Download PDF
        </a>
      )
    }
  </div>

  <div class="prose">
    <p class="about">{resume.about}</p>
  </div>

  <div class="info-cards">
    <section class="info-card">
      <Image src={educationIcon} alt="" width={44} height={44} />
      <h2>Education</h2>
      {
        resume.education.map((item) => (
          <div class="meta-item">
            <p class="meta-title">{item.degree}</p>
            <p class="muted">
              {item.school}, {item.location} · {item.year}
              {item.honors && `, ${item.honors}`}
            </p>
          </div>
        ))
      }
    </section>

    <section class="info-card">
      <Image src={certificationsIcon} alt="" width={44} height={44} />
      <h2>Certifications</h2>
      <ul class="tag-list">
        {resume.certifications.map((cert) => <li>{cert}</li>)}
      </ul>
    </section>

    <section class="info-card">
      <Image src={affiliationsIcon} alt="" width={44} height={44} />
      <h2>Affiliations</h2>
      <ul class="tag-list">
        {resume.affiliations.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </div>

  <div class="prose prose-wide">
    <h2>Industry experience</h2>
    <div class="jobs">
      {
        resume.experience.map((job) => (
          <section class="job">
            <div class="job-head">
              <h3>{job.title}</h3>
              <p class="dates muted">{job.dates}</p>
            </div>
            <p class="muted">
              {job.company} · {job.location}
            </p>
            <p>{job.description}</p>
            <p class="label">{job.highlightsLabel}</p>
            <ul>
              {job.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .cv-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .cv-header .page-title {
    margin-bottom: 0;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.55em 1.1em;
    border-radius: var(--radius);
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }
  .download-btn:hover {
    opacity: 0.85;
    color: var(--color-bg);
    text-decoration: none;
  }

  .about {
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  /* Widens just this .prose block (the experience section) to match
     .info-cards' 56rem above — the intro paragraph's .prose keeps the
     narrower default width, since a 56rem line length would be too wide
     for comfortable reading. */
  .prose-wide {
    max-width: 56rem;
  }

  /* Section headings (Industry experience, Education, Certifications,
     Affiliations) get the brand red, distinct from the blue used for
     job titles/labels/the download button/card accents elsewhere on this
     page — mirrors the header's red-for-identity, blue-for-interaction
     split. Two selectors because .info-card sits outside .prose (see
     .info-cards below for why) — both need to stay in sync. */
  .prose h2,
  .info-card h2 {
    color: var(--color-heading-accent);
  }

  .jobs {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .job {
    padding: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .job > * + * {
    margin-top: 0.5em;
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5em;
  }
  .job-head h3 {
    margin: 0;
    color: var(--color-accent);
  }
  .dates {
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .label {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  /* Education/Certifications/Affiliations as three cards above the
     experience section. Each icon is a fixed-color asset (a dark hexagon
     badge, matching the logo's hexagon motif, with a light glyph) — not
     theme-reactive, same treatment as the logo itself. The hexagon's own
     fill (#1e1e1e) matches the dark theme's page background exactly, so
     it's placed on the card surface color rather than directly on the
     page — a shade lighter, so the badge stays visible instead of
     blending into the background it'd otherwise match exactly.

     Deliberately a sibling of .prose, not nested in it: .prose caps out
     at --content-width (42rem) for comfortable paragraph reading, which
     only leaves room for 2 of these cards side by side. Un-nesting lets
     them use the page's full width instead, capped here at 56rem — wide
     enough for 3 comfortably-sized columns, without stretching them
     edge-to-edge at the site's full 72rem container width. The
     experience section below matches this same 56rem via .prose-wide,
     for a consistent width between the two sections. */
  .info-cards {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    max-width: 56rem;
    margin: 2em 0;
  }
  .info-card {
    padding: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .info-card img {
    margin-bottom: var(--space-1);
  }
  .info-card h2 {
    margin-bottom: 0.5em;
  }
  .info-card > * + * {
    margin-top: 0.5em;
  }
  .meta-item + .meta-item {
    margin-top: var(--space-2);
  }
  .meta-title {
    font-weight: 600;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tag-list li {
    padding: 0.3em 0.75em;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
  }
</style>
