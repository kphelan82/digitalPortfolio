---
// Photos are optional and live in src/assets/bio/:
//   portrait.jpg (or .png/.webp/.avif) — beside the first paragraph.
//   interests-*.jpg — any number; they become a photo grid under the interests list, in filename
//   order. The number prefix sets order and the rest of the name becomes the alt text
//   (interests-2-two-dogs-in-bandanas.jpg). Click a photo to enlarge it.
// With no files, the cards are text only.
import { Image, getImage } from 'astro:assets';
import Lightbox from '../components/Lightbox.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { site } from '../data/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/bio/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const baseName = (path: string) => path.split('/').pop()?.replace(/\.[^.]+$/, '') ?? '';
const portrait = Object.entries(photos).find(([path]) => baseName(path) === 'portrait')?.[1].default;

const snapshots = await Promise.all(
  Object.entries(photos)
    .filter(([path]) => baseName(path).startsWith('interests'))
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(async ([path, mod]) => {
      const alt = baseName(path)
        .replace(/^interests[-_ ]*/, '')
        .replace(/^\d+[-_ ]*/, '')
        .replace(/[-_]+/g, ' ')
        .trim();
      const full = await getImage({ src: mod.default, width: Math.min(2000, mod.default.width) });
      return { src: mod.default, alt, full: full.src };
    }),
);
---

<BaseLayout title="Bio" description={`About ${site.name}: 20+ years designing across digital, print and UX.`}>
  <h1 class="page-title">bio</h1>

  <div class="cards">
    <section class:list={['card', 'reveal', 'story', { 'has-photo': portrait }]}>
      <div class="story-text">
        <h2>My story</h2>
        <p>
          I was born in Charlotte, NC in 1982. I'm the oldest of four boys, and we grew up moving across
          the country. While we usually stayed somewhere along the East Coast, I spent a great few years
          in the Denver suburbs in my more formative years, which happened to be long enough to develop a
          love for Denver sports teams and mountain views. After another move back to New Jersey, I
          finished high school and moved on to study Fine Arts at Monmouth University. I spent several
          post college years in the Jersey Shore area, first working at small companies and start ups,
          before making my way into the global ad agency world. Eventually, my career took me to the
          Philadelphia suburbs, where I've been for the last few years.
        </p>
      </div>
      {
        portrait && (
          <Image class="portrait" src={portrait} alt={`Portrait of ${site.name}`} width={640} loading="eager" />
        )
      }
    </section>

    <section class="card reveal">
      <h2>What moving taught me</h2>
      <p>
        The years on the move taught me some very valuable lessons about self-reliance and
        adaptability, both of which would prove to be really valuable professionally. In today's
        fast-paced and tech-centric world, those two skills are essential, and with workforces having
        to navigate the rise of AI, I'm particularly thankful to be all too familiar with embracing
        change.
      </p>
    </section>

    <section class="card reveal">
      <h2>Where I am now</h2>
      <p>
        Throughout my 20+ years of experience — across start up, small business, agency, and
        enterprise environments — I'm most proud of the range I've built: traditional visual design
        in both digital and print, animation and motion graphics, UX/UI design, and design systems
        work. I've consistently delivered and am enamored with the idea of optimizing my own process
        wherever I can. Today, I bring that same skill set, attention to detail, and healthy curiosity
        into everything I do at Comcast Business.
      </p>
    </section>

    <section class="card reveal interests">
      <h2>Other interests</h2>
      <ul class="interest-list">
        <li>Live music (heavy metal in particular)</li>
        <li>Trying new foods and drinks</li>
        <li>Photography</li>
        <li>Travel</li>
        <li>Fitness</li>
        <li>Video games (early obsession with pixel perfect details)</li>
        <li>Home improvement/DIY projects</li>
        <li>Spending time with my wife and 2 dogs Stout and Porter</li>
        <li>Football and hockey</li>
      </ul>
      {
        snapshots.length > 0 && (
          <ul class="snapshots">
            {snapshots.map(({ src, alt, full }) => (
              <li>
                <a href={full} data-lightbox="bio" aria-label={`Enlarge: ${alt}`}>
                  <Image src={src} alt={alt} width={640} height={640} densities={[1, 2]} loading="lazy" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="card reveal contact">
      <h2>Get in touch</h2>
      <ContactLinks />
    </section>
  </div>
  <Lightbox />
</BaseLayout>

<style>
  /* Same card treatment and 56rem width as the résumé page. */
  .cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 56rem;
  }
  .card {
    padding: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .card > * + *,
  .story-text > * + *,
  .interests-text > * + * {
    margin-top: 0.75em;
  }
  .card h2 {
    margin-bottom: 0;
    color: var(--color-heading-accent);
  }

  /* Portrait beside the first paragraph from tablet up; on top (and square) on phones. */
  .story.has-photo {
    display: grid;
    gap: var(--space-2);
  }
  .story .portrait {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    order: -1;
  }
  @media (min-width: 40rem) {
    .story.has-photo {
      grid-template-columns: minmax(0, 1fr) 16rem;
      align-items: start;
    }
    .story .portrait {
      aspect-ratio: 4 / 5;
      order: 0;
    }
  }

  .interest-list {
    margin: 0;
    padding-left: 1.25em;
  }
  .interest-list li + li {
    margin-top: 0.25em;
  }
  @media (min-width: 40rem) {
    .interest-list {
      columns: 2;
      column-gap: var(--space-3);
    }
  }

  /* Photo grid under the interests list: square tiles that fill the card width. */
  .snapshots {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .snapshots a {
    display: block;
    cursor: zoom-in;
    border-radius: var(--radius);
  }
  .snapshots :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* Heading on the left, buttons on the right, both centered vertically in the card. They wrap
     under each other on narrow screens. */
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-2);
  }
  .contact > * + * {
    margin-top: 0;
  }

  /* Contact links as buttons on this page only (the footer keeps plain links). LinkedIn is the
     primary (filled, like the résumé's Download PDF button); the others are secondary (outlined).
     `:not([hidden])` keeps the email link hidden until its script builds the mailto. */
  .card :global(.contact-links) {
    gap: var(--space-1);
  }
  .card :global(.contact-links a:not([hidden])) {
    display: inline-flex;
    align-items: center;
    padding: 0.65em 1.4em;
    border: 1.5px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s ease, background-color 0.15s ease;
  }
  .card :global(.contact-links li:not(:first-child) a:not([hidden])) {
    background: transparent;
    color: var(--color-secondary);
  }
  .card :global(.contact-links a:hover) {
    opacity: 0.85;
    text-decoration: none;
  }
  .card :global(.contact-links li:first-child a:hover) {
    color: var(--color-bg);
  }
  .card :global(.contact-links li:not(:first-child) a:hover) {
    color: var(--color-secondary);
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
  }
</style>
